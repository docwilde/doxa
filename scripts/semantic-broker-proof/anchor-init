#!/bin/busybox sh
# Offline guest only. Root starts the endpoint; the test client is UID 1000.
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
exec >/dev/console 2>&1
echo DOXA_ANCHOR_VM_START
/bin/busybox mkdir -p /run/doxa-semantic
/bin/busybox chmod 755 /run/doxa-semantic
overall=0
for mode in root drop handoff; do
  /anchor_fixture "$mode" &
  broker_pid=$!
  /bin/busybox sleep 1
  /bin/busybox su guest -s /bin/sh -c "DOXA_ANCHOR_MODE=$mode /codegraph-test disposable_guest_message_sender_boundary --ignored --nocapture"
  test_status=$?
  if [ "$test_status" -ne 0 ]; then
    /bin/busybox kill "$broker_pid"
  fi
  wait "$broker_pid"
  broker_status=$?
  echo DOXA_ANCHOR_MODE="$mode" TEST_STATUS="$test_status" BROKER_STATUS="$broker_status"
  if [ "$test_status" -ne 0 ] || [ "$broker_status" -ne 0 ]; then
    overall=1
  fi
done
echo DOXA_ANCHOR_ALL_STATUS="$overall"
/bin/busybox poweroff -f
