#!/bin/busybox sh
# Offline guest only. Root owns the endpoint; UID 1000 runs the client.
/bin/busybox mount -t proc proc /proc
/bin/busybox mount -t sysfs sysfs /sys
/bin/busybox mount -t devtmpfs devtmpfs /dev
exec >/dev/console 2>&1
echo DOXA_STREAM_VM_START
/bin/busybox mkdir -p /run/doxa-semantic
/bin/busybox chmod 755 /run/doxa-semantic
overall=0
for mode in root handoff mid_handoff root_switch cid_swap extra; do
  /stream_fixture "$mode" &
  broker_pid=$!
  /bin/busybox sleep 1
  /bin/busybox su guest -s /bin/sh -c "DOXA_STREAM_MODE=$mode /codegraph-test disposable_guest_stream_sender_continuity --ignored --nocapture"
  test_status=$?
  if [ "$test_status" -ne 0 ]; then
    /bin/busybox kill "$broker_pid"
  fi
  wait "$broker_pid"
  broker_status=$?
  echo DOXA_STREAM_MODE="$mode" TEST_STATUS="$test_status" BROKER_STATUS="$broker_status"
  if [ "$test_status" -ne 0 ] || [ "$broker_status" -ne 0 ]; then
    overall=1
  fi
done
echo DOXA_STREAM_ALL_STATUS="$overall"
/bin/busybox poweroff -f
