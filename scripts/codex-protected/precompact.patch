+            .apply_turn_settings(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    doxa_auto: true,
+                    ..Default::default()
+                }
+            )
+            .await,
+        TurnSettingsUpdateOutcome::Rejected { .. }
+    ));
+    assert!(Arc::ptr_eq(&turn.next_step_settings.load_full(), &original));
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
