+        TurnSettingsUpdateOutcome::TargetUnavailable
+    );
+    assert!(matches!(
+        session
+            .apply_turn_settings(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    doxa_auto: true,
+                    model: Some(MODEL_B.into()),
+                    ..Default::default()
+                }
+            )
+            .await,
+        TurnSettingsUpdateOutcome::Rejected { .. }
+    ));
+    assert!(matches!(
+        session
+            .apply_turn_settings(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    doxa_auto: true,
+                    environments: Some(Vec::new()),
+                    ..Default::default()
+                }
+            )
+            .await,
+        TurnSettingsUpdateOutcome::Rejected { .. }
+    ));
+    let mut sourced = ConfigRequirementsWithSources::default();
+    sourced.allowed_approval_policies = Some(Sourced::new(
+        vec![AskForApproval::OnRequest],
+        RequirementSource::Unknown,
+    ));
+    {
+        let mut state = session.state.lock().await;
+        let config = Arc::make_mut(&mut state.session_configuration.original_config_do_not_use);
