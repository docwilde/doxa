+#[tokio::test]
+async fn doxa_auto_refuses_an_execpolicy_amendment_answered_after_the_switch() {
+    use codex_protocol::approvals::ExecPolicyAmendment;
+    use codex_protocol::protocol::ReviewDecision;
+
+    let amend = |command: &str| ReviewDecision::ApprovedExecpolicyAmendment {
+        proposed_execpolicy_amendment: ExecPolicyAmendment::new(vec![command.to_string()]),
+    };
+    // Positive control: without the switch the same answer writes a durable rule,
+    // so the refusal below is not vacuous.
+    let control = activation_fixture_with_model_switching(activation_models(), false).await;
+    let control_home = control.session.codex_home().await;
+    std::fs::create_dir_all(&control_home).expect("create codex home");
+    let control_rules = crate::exec_policy::default_policy_path(control_home.as_path());
+    crate::session::handlers::exec_approval(
+        &control.session,
+        "control-exec".into(),
+        Some(control.turn.sub_id.clone()),
+        amend("doxa-control-prefix"),
+    )
+    .await;
+    assert!(
+        std::fs::read_to_string(&control_rules)
+            .unwrap_or_default()
+            .contains("doxa-control-prefix")
+    );
+    control.session.abort_all_tasks(TurnAbortReason::Replaced).await;
+
+    let ActivationFixture { session, turn, .. } =
+        activation_fixture_with_model_switching(activation_models(), false).await;
+    let home = session.codex_home().await;
+    std::fs::create_dir_all(&home).expect("create codex home");
+    let rules = crate::exec_policy::default_policy_path(home.as_path());
+    let before = std::fs::read_to_string(&rules).ok();
+    #[allow(deprecated)]
+    let cwd = turn.cwd.clone();
+    let approval = session.request_command_approval(
+        &turn,
+        codex_protocol::approvals::ExecApprovalKind::Command,
+        crate::guardian::GuardianReviewContext::from(Arc::clone(&turn)).model_context(),
+        "pending-exec".into(),
+        /*approval_id*/ None,
+        /*environment_id*/ None,
+        vec!["doxa-switched-prefix".into()],
+        cwd.into(),
+        /*reason*/ None,
+        /*network_approval_context*/ None,
+        Some(ExecPolicyAmendment::new(vec!["doxa-switched-prefix".into()])),
+        /*additional_permissions*/ None,
+        /*available_decisions*/ None,
+        /*plugin_attribution_override*/ None,
+    );
+    tokio::pin!(approval);
+    assert!(futures::poll!(&mut approval).is_pending());
+    assert_eq!(
+        session
+            .apply_turn_settings(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    doxa_auto: true,
+                    ..Default::default()
+                }
+            )
+            .await,
+        TurnSettingsUpdateOutcome::Applied
+    );
+    crate::session::handlers::exec_approval(
+        &session,
+        "pending-exec".into(),
+        Some(turn.sub_id.clone()),
+        amend("doxa-switched-prefix"),
+    )
+    .await;
+    assert!(matches!(approval.await, ReviewDecision::Denied { .. }));
+    // The on-disk write precedes the in-memory policy update, so an unchanged
+    // rules file shows the amendment was never committed.
+    assert_eq!(std::fs::read_to_string(&rules).ok(), before);
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
