+#[tokio::test]
+async fn doxa_auto_serializes_final_grants_and_sanitizes_stale_guardian_responses() {
+    use codex_protocol::models::NetworkPermissions;
+    use codex_protocol::request_permissions::{
+        PermissionGrantScope, RequestPermissionProfile, RequestPermissionsResponse,
+    };
+    let ActivationFixture { session, turn, .. } =
+        activation_fixture_with_model_switching(activation_models(), false).await;
+    let environment = turn.initial_environments.primary().unwrap().selection();
+    let permissions = RequestPermissionProfile {
+        network: Some(NetworkPermissions {
+            enabled: Some(true),
+        }),
+        ..Default::default()
+    };
+    let active = session.active_turn.lock().await;
+    let finalization = session.finalize_request_permissions_for_turn(
+        RequestPermissionsResponse {
+            permissions,
+            scope: PermissionGrantScope::Session,
+            strict_auto_review: false,
+        },
+        &environment.environment_id,
+        &turn,
+    );
+    tokio::pin!(finalization);
+    // Finalization cannot inspect/commit a grant while publication owns its
+    // lock. This is an already-reviewed Guardian-style response, not a prompt.
+    assert!(futures::poll!(&mut finalization).is_pending());
+    assert!(
+        turn.granted_permissions(&environment.environment_id)
+            .is_none()
+    );
+    // Publish at apply_turn_settings' exact locked ArcSwap boundary. The test
+    // isolates this race; managed admission is exercised by the other tests.
+    let mut auto = (*turn.next_step_settings.load_full()).clone();
+    auto.doxa_auto_override = true;
+    turn.next_step_settings.store(Arc::new(auto));
+    drop(active);
+    let response = timeout(Duration::from_secs(2), finalization).await.unwrap();
+    assert!(response.permissions.is_empty());
+    assert_eq!(response.scope, PermissionGrantScope::Turn);
+    assert!(!response.strict_auto_review);
+    assert!(
+        turn.granted_permissions(&environment.environment_id)
+            .is_none()
+    );
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
