+#[tokio::test]
+async fn doxa_auto_refuses_pending_and_new_permission_grants() {
+    use codex_protocol::models::NetworkPermissions;
+    use codex_protocol::request_permissions::{
+        PermissionGrantScope, RequestPermissionProfile, RequestPermissionsArgs,
+        RequestPermissionsResponse,
+    };
+    let ActivationFixture { session, turn, .. } =
+        activation_fixture_with_model_switching(activation_models(), false).await;
+    let step = session
+        .capture_step_context(Arc::clone(&turn), &CancellationToken::new())
+        .await
+        .unwrap();
+    let environment = step
+        .environments
+        .turn_environments()
+        .next()
+        .unwrap()
+        .clone();
+    let permissions = RequestPermissionProfile {
+        network: Some(NetworkPermissions {
+            enabled: Some(true),
+        }),
+        ..Default::default()
+    };
+    // Bind the already-pending callback directly. First polling an async
+    // request does not prove its earlier preparation has finished registering.
+    let (tx_response, rx_response) = oneshot::channel();
+    {
+        let active = session.active_turn.lock().await;
+        active
+            .as_ref()
+            .unwrap()
+            .turn_state
+            .lock()
+            .await
+            .insert_pending_request_permissions(
+                "doxa-pending-permission".into(),
+                crate::state::PendingRequestPermissions {
+                    tx_response,
+                    requested_permissions: permissions.clone(),
+                    environment: environment.clone(),
+                    turn_context: Arc::clone(&turn),
+                },
+            );
+    }
+    assert_eq!(
+        session
+            .apply_turn_settings(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    doxa_auto: true,
+                    ..Default::default()
+                }
+            )
+            .await,
+        TurnSettingsUpdateOutcome::Applied
+    );
+    session
+        .notify_request_permissions_response(
+            "doxa-pending-permission",
+            RequestPermissionsResponse {
+                permissions: permissions.clone(),
+                scope: PermissionGrantScope::Session,
+                strict_auto_review: false,
+            },
+        )
+        .await;
+    let response = timeout(Duration::from_secs(2), rx_response)
+        .await
+        .unwrap()
+        .unwrap();
+    assert!(response.permissions.is_empty());
+    assert!(
+        turn.granted_permissions(&environment.selection.environment_id)
+            .is_none()
+    );
+    let next = timeout(
+        Duration::from_secs(2),
+        session.request_permissions_for_environment(
+            &step,
+            "doxa-new-permission".into(),
+            RequestPermissionsArgs {
+                environment_id: None,
+                reason: Some("synthetic network request".into()),
+                permissions,
+            },
+            environment.selection(),
+            CancellationToken::new(),
+        ),
+    )
+    .await
+    .unwrap()
+    .unwrap();
+    assert!(next.permissions.is_empty());
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
