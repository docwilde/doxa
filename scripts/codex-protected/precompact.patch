+            "{}",
+            "{\"continue\":true}",
+            "{\"continue\":\"true\",\"suppressOutput\":true}",
+        ] {
+            let parsed = parse_pre_completed(
+                &required,
+                run_result(Some(0), output, ""),
+                Some("turn-1".to_string()),
+            );
+            assert_eq!(
+                parsed.completed.run.status,
+                HookRunStatus::Failed,
+                "{output}"
+            );
+        }
+        for failure in [
+            "failed to spawn hook command",
+            "hook command timed out",
+            "failed to read hook output",
+        ] {
+            let mut result = run_result(None, "", "");
+            result.error = Some(failure.to_string());
+            let parsed = parse_pre_completed(&required, result, Some("turn-1".to_string()));
+            assert_eq!(parsed.completed.run.status, HookRunStatus::Failed);
+        }
+        let parsed = parse_pre_completed(
+            &required,
+            run_result(Some(0), r#"{"continue":true,"suppressOutput":true}"#, ""),
+            Some("turn-1".to_string()),
+        );
+        assert_eq!(parsed.completed.run.status, HookRunStatus::Completed);
+    }
