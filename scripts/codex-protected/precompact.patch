+#[tokio::test]
+async fn doxa_auto_tightens_captured_steps_without_changing_sandbox_or_thread_defaults() {
+    let ActivationFixture { session, turn, .. } = activation_fixture_with_model_switching(activation_models(), false).await;
+    let sandbox = turn.sandbox_policy();
+    let desired = desired_step_settings(&session).await;
+    let captured = session.capture_step_context(Arc::clone(&turn), &CancellationToken::new()).await.unwrap();
+    assert_eq!(captured.approval_policy(), AskForApproval::OnRequest);
+    assert_eq!(session.apply_turn_settings(&turn.sub_id, TurnSettingsUpdate { doxa_auto: true, ..Default::default() }).await,
+        TurnSettingsUpdateOutcome::Applied);
+    assert_eq!(captured.settings.approval_policy(), AskForApproval::OnRequest);
+    assert_eq!(captured.approval_policy(), AskForApproval::Never);
+    assert_eq!(turn.sandbox_policy(), sandbox);
+    assert_eq!(desired_step_settings(&session).await, desired);
+    assert_eq!(session.apply_turn_settings(&turn.sub_id, TurnSettingsUpdate { doxa_auto: true, ..Default::default() }).await,
+        TurnSettingsUpdateOutcome::Applied);
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
+
+#[tokio::test]
+async fn doxa_auto_refuses_wrong_turn_mixed_settings_and_managed_policy() {
+    let ActivationFixture { session, turn, .. } = activation_fixture_with_model_switching(activation_models(), false).await;
+    let original = turn.next_step_input.load_full();
+    assert_eq!(session.apply_turn_settings("other-turn", TurnSettingsUpdate { doxa_auto: true, ..Default::default() }).await,
+        TurnSettingsUpdateOutcome::TargetUnavailable);
+    assert!(matches!(session.apply_turn_settings(&turn.sub_id,
+        TurnSettingsUpdate { doxa_auto: true, model: Some(MODEL_B.into()), ..Default::default() }).await,
+        TurnSettingsUpdateOutcome::Rejected { .. }));
+    let mut sourced = ConfigRequirementsWithSources::default();
+    sourced.allowed_approval_policies = Some(Sourced::new(vec![AskForApproval::OnRequest], RequirementSource::Unknown));
+    {
+        let mut state = session.state.lock().await;
+        let config = Arc::make_mut(&mut state.session_configuration.original_config_do_not_use);
+        config.config_layer_stack = ConfigLayerStack::new(
+            config.config_layer_stack.all_layers_low_to_high().cloned().collect(),
+            ConfigRequirements::try_from(sourced.clone()).unwrap(), sourced.into_toml()).unwrap();
+    }
+    assert!(matches!(session.apply_turn_settings(&turn.sub_id,
+        TurnSettingsUpdate { doxa_auto: true, ..Default::default() }).await, TurnSettingsUpdateOutcome::Rejected { .. }));
+    assert!(Arc::ptr_eq(&turn.next_step_input.load_full(), &original));
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
