+#[tokio::test]
+async fn doxa_auto_network_prompt_denies_before_and_after_review() {
+    use crate::guardian::GuardianReviewContext;
+    use crate::tools::ApprovalContext;
+    use crate::tools::ApprovalResolution;
+    use crate::tools::ApprovalResolutionSource;
+    use crate::tools::sandboxing::ApprovalAction;
+    use crate::tools::sandboxing::ToolError;
+    use codex_protocol::approvals::NetworkApprovalProtocol;
+    use codex_protocol::protocol::ReviewDecision;
+    use codex_tools::ToolName;
+    use codex_utils_absolute_path::AbsolutePathBuf;
+
+    let ActivationFixture { session, turn, .. } =
+        activation_fixture_with_model_switching(activation_models(), false).await;
+    let mut review_context = GuardianReviewContext::from(Arc::clone(&turn));
+    review_context.approval_policy = AskForApproval::OnRequest;
+    review_context.approvals_reviewer = ApprovalsReviewer::User;
+    let context = ApprovalContext {
+        exec_requirement: None,
+        review_context,
+        cancellation_token: None,
+        call_id: "doxa-network-prompt".into(),
+        tool_name: ToolName::plain("exec_command"),
+        strict_auto_review: false,
+        approval_reason: Some("network access requires approval".into()),
+        retry_reason: None,
+        network_approval_context: None,
+    };
+    let action = ApprovalAction::NetworkAccess {
+        id: context.call_id.clone(),
+        turn_id: turn.sub_id.clone(),
+        environment_id: codex_exec_server::LOCAL_ENVIRONMENT_ID.to_string(),
+        target: "https://example.com:443".into(),
+        host: "example.com".into(),
+        protocol: NetworkApprovalProtocol::Https,
+        port: 443,
+        trigger: None,
+        hook_command: "curl https://example.com".into(),
+        hook_run_id: "doxa-network-hook".into(),
+        command: vec!["network-access".into(), "https://example.com:443".into()],
+        cwd: AbsolutePathBuf::try_from(std::env::temp_dir()).unwrap(),
+    };
+    let approved = session
+        .request_approval_with_user_prompt(&action, &context, async {
+            ApprovalResolution {
+                decision: ReviewDecision::Approved,
+                source: ApprovalResolutionSource::User,
+                cancellation_reason: None,
+            }
+        })
+        .await;
+    assert!(matches!(approved.result, Ok(ReviewDecision::Approved)));
+
+    let (answer, response) = tokio::sync::oneshot::channel();
+    let pending = session.request_approval_with_user_prompt(&action, &context, async {
+        response.await.unwrap();
+        ApprovalResolution {
+            decision: ReviewDecision::Approved,
+            source: ApprovalResolutionSource::User,
+            cancellation_reason: None,
+        }
+    });
+    tokio::pin!(pending);
+    assert!(futures::poll!(&mut pending).is_pending());
+    assert_eq!(
+        session
+            .apply_turn_settings(
+                &turn.sub_id,
+                TurnSettingsUpdate {
+                    doxa_auto: true,
+                    ..Default::default()
+                }
+            )
+            .await,
+        TurnSettingsUpdateOutcome::Applied,
+    );
+    answer.send(()).unwrap();
+    let denied = pending.await;
+    assert!(matches!(denied.result, Err(ToolError::Rejected(_))));
+    assert_eq!(denied.source, Some(ApprovalResolutionSource::User));
+
+    let refused = session
+        .request_approval_with_user_prompt(&action, &context, async {
+            panic!("auto mode must refuse before polling the network prompt")
+        })
+        .await;
+    assert!(matches!(refused.result, Err(ToolError::Rejected(_))));
+    assert_eq!(refused.source, None);
+    session.abort_all_tasks(TurnAbortReason::Replaced).await;
+}
