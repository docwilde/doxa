/* DOXA theme -- Phase 1 slice 2 scope only (see README's status table: full
   spec lives in the private vault, this file implements the approved
   load-bearing subset).

   Tokens: dark surface ramp #171512 (screen) -> #221F1A (blocks) -> #2A251E
   (nested chips) -> #3A3429 (borders, top of the ramp); primary #D97757
   (Claude orange); round borders everywhere; generous padding; warm
   off-white text (#F2E9DD body / #D8CDBB secondary). The block accent is
   the literal "▎" glyph doxa/app.py's TurnBlock/ToolChip prefix their
   titles with -- a left-rule character, not a CSS border trick, so it reads
   identically whether or not the terminal's border-drawing glyphs render
   cleanly.

   NOTHING ANIMATES. No transitions, no pulsing borders, no spinners: the
   in-flight turn marker (`.thinking` below) is a static Static, having
   replaced a LoadingIndicator whose 16 Hz auto-refresh was CPU spent on
   reassurance. The only interval left anywhere is Textual's own 2 Hz
   caret blink on the focused prompt input, which is load-bearing -- it is
   how you find the caret -- and runs on exactly one widget. */

Screen {
    background: #171512;
    color: #F2E9DD;
}

/* Session tabs (Phase 3): the TabbedContent hosts one SessionPane per
   session; both default to height:auto, which would collapse the panes'
   1fr block list -- pin the whole tab system to the screen. The tab strip
   itself rides the surface ramp; the active tab gets the orange accent. */
#session-tabs {
    height: 1fr;
}

SessionPane {
    height: 1fr;
    padding: 0;
}

#session-tabs ContentTabs {
    background: #171512;
    color: #D8CDBB;
}

#session-tabs Tab {
    color: #D8CDBB;
}

#session-tabs Tab.-active {
    color: #D97757;
    text-style: bold;
}

#session-tabs Underline > .underline--bar {
    color: #D97757;
    background: #3A3429;
}

/* Ctrl+Q with a turn running: the one close that asks. Same modal wash and
   surface ramp as the palette and the settings screen. */
CloseWithTurnRunning {
    align: center middle;
    background: #171512 60%;
}

#close-confirm {
    width: 64;
    height: auto;
    background: #221F1A;
    border: round #3A3429;
    padding: 1 2;
}

#close-confirm-title {
    color: #D97757;
    text-style: bold;
    padding-bottom: 1;
}

#close-confirm-body {
    color: #D8CDBB;
}

#close-confirm-buttons {
    height: 1;
    padding-top: 1;
}

#close-confirm-buttons > Static {
    width: auto;
    padding-right: 2;
    color: #F2E9DD;
}

/* Inline tab rename (double-click a tab header): the field takes the
   tab's own slot in the strip -- one row high, no border of its own, so
   the strip does not jump while a name is being typed. */
#tab-rename {
    height: 1;
    border: none;
    padding: 0 1;
    background: #2A251E;
    color: #F2E9DD;
}

#block-list {
    background: #171512;
    padding: 1 2;
}

Collapsible {
    background: #221F1A;
    border: round #3A3429;
    padding: 1 2;
    margin-bottom: 1;
}

Collapsible > CollapsibleTitle {
    color: #D97757;
    text-style: bold;
}

.turn-body {
    color: #F2E9DD;
    padding: 1 1;
}

.turn-tools {
    padding: 0 1;
}

ToolChip {
    background: #2A251E;
    border: round #3A3429;
    margin: 0 0 1 0;
    padding: 0 1;
}

ToolChip > CollapsibleTitle {
    color: #D8CDBB;
    text-style: none;
}

.chip-body {
    color: #D8CDBB;
    padding: 1 2;
}

/* Trace tree: a subagent's own tool calls nest as further chips inside
   their Task chip (indented one step), and its streamed text renders in
   the dimmed .chip-subout block -- both lazily, on expand. */
.chip-subcalls {
    height: auto;
    padding: 0 0 0 2;
}

.chip-subout {
    color: #D8CDBB;
    padding: 0 2;
}

/* Image surfaces (doxa/images.py ladder): the media area inside a tool
   chip, the /img debug block, and the text fallback every tier degrades
   to. Sizes stay auto -- textual-image widgets measure themselves. */
.chip-media {
    height: auto;
}

.image-block {
    height: auto;
    background: #221F1A;
    border: round #3A3429;
    padding: 0 2;
    margin-bottom: 1;
}

.image-caption {
    color: #D97757;
    text-style: bold;
}

.image-widget {
    height: auto;
    max-height: 24;
}

.image-fallback {
    color: #D8CDBB;
}

.thinking {
    color: #D97757;
    height: 1;
}

.system-block {
    background: #221F1A;
    color: #D8CDBB;
    border: round #3A3429;
    padding: 0 2;
    margin-bottom: 1;
}

/* Peer messages: deliberately dimmer than a turn -- border one step DOWN
   the surface ramp (#2A251E, the chip surface, instead of #3A3429) and
   secondary text only. Another session talking must never read as this
   session's own output. */
PeerMessageBlock {
    background: #1D1B17;
    color: #D8CDBB;
    border: round #2A251E;
    padding: 0 2;
    margin-bottom: 1;
}

#status-bar {
    background: #221F1A;
    color: #D8CDBB;
    height: 1;
    padding: 0 2;
}

/* Slash autocomplete (doxa/app.py's SlashComplete): the dropdown above the
   prompt input. Same treatment as the palette's result list -- block
   surface, ramp-top border, Claude-orange on the highlighted row -- so the
   two command surfaces look like the one registry they read. Height is
   auto and capped: a dozen commands must never eat the transcript. */
#slash-complete {
    height: auto;
    max-height: 10;
    background: #221F1A;
    color: #D8CDBB;
    border: round #3A3429;
    margin: 0 1;
}

/* Group headers are disabled Options: dim, unselectable, and skipped by
   the highlight -- a label, never a destination. */
#slash-complete > .option-list--option-disabled {
    color: #8A8073;
    text-style: bold;
}

/* Ctrl+P palette: its section headers are the SAME disabled rows as the
   dropdown's group headers, so both command surfaces read alike. */
CommandList > .option-list--option-disabled {
    color: #8A8073;
    text-style: bold;
}

#slash-complete > .option-list--option-highlighted {
    color: #D97757;
    background: #2A251E;
    text-style: bold;
}

#prompt-input {
    background: #221F1A;
    color: #F2E9DD;
    border: round #D97757;
    margin: 0 1 1 1;
}

/* Belief inspector -- Phase 2 stub pane (palette-toggled, hidden by
   default). Docked right so toggling never reflows the block list's
   scroll anchor; real content lands in Phase 3. Wears the house panel
   header: title plus a clickable close affordance. */
#belief-inspector {
    dock: right;
    display: none;
    width: 46;
    height: 1fr;
    background: #1D1B17;
    color: #D8CDBB;
    border: round #3A3429;
    padding: 1 2;
}

#inspector-header {
    height: 1;
}

#inspector-title {
    width: 1fr;
    color: #D97757;
    text-style: bold;
}

#inspector-body {
    color: #D8CDBB;
    padding-top: 1;
}

/* Command palette (Ctrl+P): Textual's built-in modal, reskinned onto the
   DOXA surface ramp -- dimmed screen behind (the 60% wash over the screen
   surface is the house modal-overlay treatment), block surface for the
   panel, Claude-orange for matched spans. */
CommandPalette {
    background: #171512 60%;
}

CommandPalette > Vertical {
    background: #221F1A;
}

CommandPalette #--input {
    background: #221F1A;
    border: round #D97757;
}

CommandPalette #--results {
    background: #221F1A;
}

CommandPalette CommandList {
    background: #221F1A;
    border: round #3A3429;
    color: #F2E9DD;
}

CommandPalette > .command-palette--help-text {
    color: #D8CDBB;
}

CommandPalette > .command-palette--highlight {
    color: #D97757;
    text-style: bold;
}

/* The live /search popup: same slab as the slash dropdown, directly above
   the prompt, never focused. Taller cap than the command dropdown because
   a result row carries a title, a date and a snippet. */
#session-search {
    height: auto;
    max-height: 12;
    background: #221F1A;
    color: #D8CDBB;
    border: round #3A3429;
    margin: 0 1;
}

#session-search > .option-list--option-disabled {
    color: #8A8073;
}

#session-search > .option-list--option-highlighted {
    background: #2A251E;
    text-style: bold;
}

/* Settings (Ctrl+, / /settings): same modal treatment again -- dimmed
   screen wash, block surface, ramp-top border. Rows are label / field /
   help, deliberately plain: nothing in this panel animates. */
SettingsScreen {
    align: center middle;
    background: #171512 60%;
}

#settings-panel {
    width: 80%;
    max-width: 100;
    height: auto;
    max-height: 90%;
    background: #221F1A;
    border: round #3A3429;
    padding: 1 2;
}

#settings-header {
    height: 1;
}

#settings-title {
    width: 1fr;
    color: #D97757;
    text-style: bold;
}

/* Panel close affordance: the ✕ every closeable panel in the house wears
   in its upper-right corner, for the mouse users the key bindings leave
   out. Static, not a Button -- no ripple, no transition, no timer. */
.panel-close {
    width: 3;
    content-align: center middle;
    color: #D8CDBB;
    text-style: bold;
}

.panel-close:hover {
    color: #D97757;
}

#settings-categories {
    height: auto;
    max-height: 30;
}

#settings-categories ContentTabs {
    background: #221F1A;
    color: #D8CDBB;
}

#settings-categories Tab.-active {
    color: #D97757;
    text-style: bold;
}

#settings-categories Underline > .underline--bar {
    color: #D97757;
    background: #3A3429;
}

.settings-rows {
    height: auto;
    max-height: 24;
    padding: 1 0 0 0;
}

/* The effective value, and where it came from -- the two things a
   settings row exists to tell you. */
.setting-value {
    color: #D97757;
    padding: 0 1;
}

.setting-shadowed {
    color: #8A8073;
    padding: 0 1;
}

.setting-note {
    color: #8A8073;
    padding: 0 1 1 1;
}

.setting-label {
    color: #F2E9DD;
    text-style: bold;
}

.setting-field {
    background: #1D1B17;
    color: #F2E9DD;
    border: round #3A3429;
}

.setting-field:focus {
    border: round #D97757;
}

.setting-readonly {
    color: #D8CDBB;
    padding: 0 1;
}

.setting-help {
    color: #8A8073;
    padding: 0 1 1 1;
}

#settings-path {
    color: #8A8073;
    padding-top: 1;
}

#settings-hint {
    color: #D8CDBB;
}

/* /setup: same modal treatment as settings and the close-confirm --
   dimmed wash, block surface, ramp-top border. One finding at a time,
   plain text, nothing animated. */
SetupScreen {
    align: center middle;
    background: #171512 60%;
}

#setup-panel {
    width: 74;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    background: #221F1A;
    border: round #3A3429;
    padding: 1 2;
}

#setup-header {
    height: 1;
}

#setup-title {
    width: 1fr;
    color: #D97757;
    text-style: bold;
}

#setup-body {
    color: #D8CDBB;
    padding: 1 0;
}

#setup-hint {
    color: #D8CDBB;
}
