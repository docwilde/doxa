# Review and advance the snapshot date together with debian-bookworm.packages.
# Base images have no CA store, so apt verifies TLS with the pinned
# snapshot-ca.pem until ca-certificates installs.
deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm main
deb [check-valid-until=no] https://snapshot.debian.org/archive/debian/20260901T000000Z bookworm-updates main
deb [check-valid-until=no] https://snapshot.debian.org/archive/debian-security/20260901T000000Z bookworm-security main
